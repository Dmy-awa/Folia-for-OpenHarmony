# 归一化换行符，避免 Windows / macOS / Linux 协作时整文件 diff
* text=auto eol=lf

# Shell 脚本必须是 LF，否则在 Linux / macOS 上会报 "bad interpreter"
*.sh            text eol=lf
hvigorw         text eol=lf

# Windows 批处理必须是 CRLF
*.bat           text eol=crlf
*.cmd           text eol=crlf

# PowerShell 两种换行都能跑，统一成 CRLF 便于 Windows 编辑器
*.ps1           text eol=crlf

# HarmonyOS / DevEco 配置
*.json5         text eol=lf
*.ets           text eol=lf
*.ts            text eol=lf
*.md            text eol=lf

# 二进制，禁止任何换行转换与 diff
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.jar           binary
*.hap           binary
*.hsp           binary
*.har           binary
*.p12           binary
*.cer           binary
*.p7b           binary
*.so            binary
*.dll           binary
*.exe           binary

# 让 GitHub 语言统计不再把 SVG 图标算进去
*.svg           linguist-vendored

# 生成物不计入语言统计
ci/*.yml        linguist-documentation
docs/*.md       linguist-documentation
tools/*.py      linguist-documentation
